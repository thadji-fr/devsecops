# EXEMPLE UNIQUEMENT, jamais des valeurs de production.
# Copier vers .env en laboratoire (ignoré par .gitignore).
# Les chemins ci-dessous ne correspondent à aucun hôte réel.
TZ=Europe/Paris
PUID=1000
PGID=1000
STACK_ROOT=./example-data
EDGE_DOMAIN=example.org
EDGE_VALIDATION=http
ACME_EMAIL=admin@example.org
SWAG_DOCKER_MODS=
# Valeur par défaut LOOPBACK pour éviter d'exposer une API de test.
# Sur un banc WireGuard isolé, indiquer l'adresse wg0 de ce banc.
WG_BIND_IP=127.0.0.1
GUAC_DB_NAME=guacamole_db
GUAC_DB_USER=guacamole_user
# Secrets absents : à définir hors Git pour "docker compose config".
GUAC_DB_PASSWORD=
GUAC_DB_ROOT_PASSWORD=
ARCANE_ENCRYPTION_KEY=
ARCANE_PUBLIC_URL=https://admin.example.org
ARCANE_PROJECTS_DIR=/srv/example/compose-projects
